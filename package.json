{
  "name": "balance-window-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm --workspace web run dev",
    "dev:pages": "npm --workspace web run dev:pages",
    "build": "npm --workspace web run build && npm --workspace web run build:functions && cp web/.wrangler/pages-functions/index.js web/dist/_worker.js",
    "build:marketing": "node scripts/build-marketing.mjs",
    "build:functions": "npm --workspace web run build:functions && cp web/.wrangler/pages-functions/index.js web/dist/_worker.js",
    "preview": "npm --workspace web run preview",
    "cf:types": "npm --workspace web run cf:types",
    "db:generate": "npm --workspace web run db:generate",
    "db:migrate:local": "npm --workspace web run db:migrate:local",
    "db:migrate:remote": "npm --workspace web run db:migrate:remote",
    "type-check": "npm --workspace web run type-check",
    "test": "npm --workspace web run test",
    "test:watch": "npm --workspace web run test:watch"
  }
}
