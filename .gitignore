# Xcode per-user state and release/test artifacts must never enter a
# reproducible source snapshot.
**/xcuserdata/
*.xcuserstate
*.xcresult
*.xcarchive

# Apple signing material is always supplied by Xcode/Apple tooling and must
# not be copied into a source snapshot.
*.p8
AuthKey_*
*.mobileprovision
*.cer
*.p12
